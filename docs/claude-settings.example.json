{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "bashOutputMaxChars": 12000,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/context-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking context cost"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/verify-site.sh:*)",
      "Bash(scripts/delegate.sh:*)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
