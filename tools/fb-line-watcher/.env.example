# ===== LINE Messaging API（必填）=====
# LINE Developers Console → Messaging API channel → 「Channel access token (long-lived)」
LINE_CHANNEL_ACCESS_TOKEN=
# 同一個 channel 的「Channel secret」（只有 npm run get-line-ids 取群組 ID 時用來驗證 webhook 簽章）
LINE_CHANNEL_SECRET=
# 要接收通知的 LINE 群組 ID（C 開頭，33 字元）或個人 user ID（U 開頭）
# 取得方式：把官方帳號加進群組後執行 npm run get-line-ids（見 README 第 4 節）
LINE_DESTINATION_ID=

# ===== 圖片主機（LINE 只能顯示公開 HTTPS 網址上的圖片；擇一設定，或先用 none 只傳文字）=====
# images.publisher = local_http 時：對外可達的 HTTPS 網址（例如 Cloudflare Tunnel 給的網址，不要結尾斜線）
PUBLIC_BASE_URL=

# images.publisher = s3 時（Cloudflare R2 / AWS S3 / MinIO 等 S3 相容儲存）
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 公開讀取網址前綴（R2 的 r2.dev 網址或自訂網域，不要結尾斜線）
S3_PUBLIC_BASE_URL=

# ===== 手機通知觸發（選用，但強烈建議：可大幅降低 Facebook 帳號風險）=====
# 手機收到 Facebook 通知時打電腦的網址，讓 watcher 立刻巡邏一次。
# 執行 npm run trigger-url 會產生一組隨機密鑰並印出完整網址。詳見 PHONE_TRIGGER.md。
TRIGGER_TOKEN=

# ===== 選用 =====
# 日誌等級：trace | debug | info | warn | error
LOG_LEVEL=info
# 設為 1 時在終端機用彩色可讀格式輸出日誌
LOG_PRETTY=1
